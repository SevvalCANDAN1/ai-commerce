# Copy to .env and replace placeholder values before running the project.
# Never commit .env to git.

# MongoDB (shared by Docker Compose and FastAPI)
MONGO_ROOT_USERNAME=your_mongo_username
MONGO_ROOT_PASSWORD=your_secure_mongo_password_min_8_chars
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=ai_commerce
MONGO_AUTH_SOURCE=admin

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cart pricing (optional — defaults exist in config.py)
TAX_RATE=0.20
FREE_SHIPPING_THRESHOLD=500.0
SHIPPING_FLAT_RATE=29.99
