# Copy to .env and replace placeholder values before running the project.
# Never commit .env to git.

# MongoDB (shared by Docker Compose and FastAPI)
MONGO_ROOT_USERNAME=your_mongo_username
MONGO_ROOT_PASSWORD=your_secure_mongo_password_min_8_chars
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=ai_commerce
MONGO_AUTH_SOURCE=admin
# Optional Atlas connection string (enables $vectorSearch). Local mongo:7 still
# supports semantic search via cosine scan when product embeddings exist.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ai_commerce

# JWT
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cart pricing (optional — defaults exist in config.py)
TAX_RATE=0.20
FREE_SHIPPING_THRESHOLD=500.0
SHIPPING_FLAT_RATE=29.99

# Azure OpenAI — semantic search (Modül 2, optional for local dev)
# When unset, search falls back to keyword matching.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_api_key
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-02-01
EMBEDDING_DIMENSIONS=1536
SEARCH_TOP_K=5
SEARCH_VECTOR_INDEX_NAME=product_vector_index
AZURE_OPENAI_TIMEOUT_SECONDS=10.0
